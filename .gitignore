# -------------------------------------------------------------------------
# Dart / Flutter Package Essentials
# -------------------------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
build/

# Avoid committing locally generated HTML documentation
doc/api/

# If your package includes web/javascript compilation artifacts
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map

# -------------------------------------------------------------------------
# Package-Specific Dependency Rule
# -------------------------------------------------------------------------
# Do NOT ignore pubspec.lock for library packages.
# This ensures tests run against the latest compatible dependency versions.
!pubspec.lock

# -------------------------------------------------------------------------
# Flutter Plugins & Platform Artifacts (If a Flutter Plugin Package)
# -------------------------------------------------------------------------
.flutter-plugins
.flutter-plugins-dependencies
.metadata
lib/generated_plugin_registrant.dart

# -------------------------------------------------------------------------
# IDEs and Editors
# -------------------------------------------------------------------------
# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/

# MacOS specific
.DS_Store
